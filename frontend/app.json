{
  "expo": {
    "name": "Cidade Ativa",
    "slug": "cidade-ativa",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cidadeativa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.cidadeativa.app"
    },
    "android": {
      "package": "com.cidadeativa.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3F77",
          "image": "./assets/images/splash-cidade-ativa.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Cidade Ativa usa a sua localização para marcar no mapa onde está o problema urbano que você está reportando."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cidade Ativa acessa suas fotos para anexar uma imagem à ocorrência.",
          "cameraPermission": "O Cidade Ativa usa a câmera para fotografar o problema urbano que você está reportando.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "609685fa-b0ee-4958-8da7-c4a4e8f9f948"
      }
    },
    "owner": "andre-lcs"
  }
}
